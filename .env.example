# Public HTTPS endpoint for card submissions. Configure this at build time with
# --dart-define=SUBMISSIONS_ENDPOINT_URL=https://example.com/api/submissions
SUBMISSIONS_ENDPOINT_URL=

# Maintainer-only configuration for scripts/create_google_sheet.dart and
# scripts/test_sheets_submission.dart. Never pass these values to a Flutter
# build or deploy them in a client-accessible environment.
SHEETS_SPREADSHEET_ID=
SHEETS_CREDENTIALS_JSON=

# PostHog configuration (optional overrides)
POSTHOG_API_KEY=
POSTHOG_HOST=https://eu.i.posthog.com
POSTHOG_ALLOW_DEBUG=false
